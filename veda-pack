#!/usr/bin/env bash
#
#  veda-pack -- build the mirror bundle from this working installation
#
#  Packs each tool in resources/tools/ into its own compressed archive, records
#  a SHA-256 and byte size for every one in installer/manifest/mirror.manifest,
#  and prints the commands to upload the set.
#
#  Usage:
#     ./veda-pack                        pack everything into dist/mirror/
#     ./veda-pack --only algpred2        pack a single tool
#     ./veda-pack --dtu-only             pack just the five licence-gated tools
#     ./veda-pack --free-only            pack just the publicly redistributable ones
#     ./veda-pack --out DIR              write archives somewhere else
#     ./veda-pack --format tar.zst       use zstd (smaller, faster; needs zstd)
#     ./veda-pack --upload gh://owner/repo@tag
#                                        pack, then upload via the gh CLI
#
#  Archive layout: each archive holds the tool's CONTENTS at the top level
#  (tar -C <tooldir> .), so the installer extracts it straight into
#  resources/tools/<dir>/ with no nesting to guess at.
#
#  Before packing, each tool is cleaned of macOS litter (._*, .DS_Store,
#  __MACOSX) and __pycache__, so the archives are smaller and do not carry
#  the junk that makes several of these tools misbehave.
#
#  LICENCE NOTE: NetMHCpan, NetMHCIIpan, GibbsCluster, Seq2Logo and DeepLoc are
#  licensed by DTU Health Tech for your own academic use and may NOT be
#  redistributed. If your bundle includes them, host it somewhere access-
#  controlled -- a PRIVATE GitHub repo's release assets, or storage only your
#  group can read. Do not put them in a public release, on a public web server,
#  or on Zenodo. veda-pack warns when the bundle contains them.
#
set -Eeuo pipefail

VEDA_SELF=${BASH_SOURCE[0]}
while [[ -L "$VEDA_SELF" ]]; do
    _link=$(readlink "$VEDA_SELF")
    [[ "$_link" == /* ]] && VEDA_SELF=$_link || VEDA_SELF=$(dirname "$VEDA_SELF")/$_link
done
VEDA_APP_DIR=$(cd "$(dirname "$VEDA_SELF")" && pwd -P)
VEDA_INSTALLER_DIR="$VEDA_APP_DIR/installer"
VEDA_TOOLS_DIR="$VEDA_APP_DIR/resources/tools"
if [[ ! -d "$VEDA_INSTALLER_DIR/lib" ]]; then
    printf '\nFATAL: %s needs the installer/ directory next to it.\n' "$(basename "$VEDA_SELF")" >&2
    printf 'Looked for: %s\n' "$VEDA_INSTALLER_DIR/lib" >&2
    printf 'Run it from a complete VEDA checkout, not a copied single file.\n\n' >&2
    exit 1
fi

VEDA_HOME=${VEDA_HOME:-$HOME/.veda}

OUT_DIR="$VEDA_APP_DIR/dist/mirror"
FORMAT="tar.gz"
ONLY=''
FILTER='all'
UPLOAD=''
VEDA_ASSUME_YES=0
VEDA_DRY_RUN=0
VEDA_VERBOSE=0
VEDA_LOG=""

while (( $# )); do
    case $1 in
        --only)      ONLY=${2:?--only needs a tool id}; shift ;;
        --dtu-only)  FILTER='dtu' ;;
        --free-only) FILTER='free' ;;
        --out)       OUT_DIR=${2:?--out needs a directory}; shift ;;
        --format)    FORMAT=${2:?--format needs tar.gz or tar.zst}; shift ;;
        --upload)    UPLOAD=${2:?--upload needs a gh://owner/repo@tag}; shift ;;
        -y|--yes)    VEDA_ASSUME_YES=1 ;;
        -v|--verbose) VEDA_VERBOSE=1 ;;
        -h|--help)   sed -n '2,37p' "$VEDA_SELF" | sed 's/^#\s\?//'; exit 0 ;;
        *) printf 'Unknown option: %s (try --help)\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

# shellcheck source=/dev/null
. "$VEDA_INSTALLER_DIR/lib/common.sh"

case "$FORMAT" in
    tar.gz) ;;
    tar.zst) have zstd || die "zstd not installed: sudo apt-get install zstd" ;;
    *) die "unsupported --format '$FORMAT' (use tar.gz or tar.zst)" ;;
esac

MANIFEST="$VEDA_INSTALLER_DIR/manifest/mirror.manifest"
TOOLS_MANIFEST="$VEDA_INSTALLER_DIR/manifest/tools.manifest"
[[ -f "$TOOLS_MANIFEST" ]] || die "tool manifest missing: $TOOLS_MANIFEST"

banner "VEDA mirror packer"
log "tools  : $VEDA_TOOLS_DIR"
log "output : $OUT_DIR"
log "format : $FORMAT"

mkdir -p "$OUT_DIR"

declare -a ROWS=()
declare -a PACKED=()
declare -a SKIPPED=()
declare -a DTU_INCLUDED=()
TOTAL_RAW=0
TOTAL_PACKED=0

# ---------------------------------------------------------------------------
pack_one() {
    local id=$1 kind=$2 dir=$3 sentinel=$4 label=$5
    local path="$VEDA_TOOLS_DIR/$dir"

    if [[ ! -d "$path" ]]; then
        log_warn "$id -- not installed, skipping"
        SKIPPED+=("$id (not installed)")
        return 0
    fi
    if [[ "$sentinel" != '-' && ! -e "$path/$sentinel" ]]; then
        log_warn "$id -- incomplete (no $sentinel), skipping"
        SKIPPED+=("$id (incomplete)")
        return 0
    fi
    if [[ -f "$path/$sentinel" ]] && head -c 48 "$path/$sentinel" 2>/dev/null \
            | grep -q 'version https://git-lfs'; then
        log_err "$id -- $sentinel is an unresolved git-lfs pointer; refusing to pack a stub"
        SKIPPED+=("$id (lfs pointer)")
        return 0
    fi

    # Clean before measuring, so the archive and the sizes agree.
    strip_mac_cruft "$path"
    find "$path" -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null || true

    local raw; raw=$(du -sb "$path" 2>/dev/null | awk '{print $1}')
    local file="$id.$FORMAT"
    local out="$OUT_DIR/$file"

    log_info "packing $id ($(numfmt --to=iec "$raw" 2>/dev/null || echo "$raw B")) -> $file"

    local rc=0
    case "$FORMAT" in
        tar.gz)  tar -czf "$out" -C "$path" . || rc=1 ;;
        tar.zst) tar --use-compress-program='zstd -19 -T0' -cf "$out" -C "$path" . || rc=1 ;;
    esac
    (( rc == 0 )) || { log_err "$id -- archive failed"; rm -f "$out"; SKIPPED+=("$id (pack failed)"); return 0; }

    local bytes sha
    bytes=$(stat -c%s "$out")
    sha=$(sha256sum "$out" | awk '{print $1}')

    ROWS+=("$id|$file|$sha|$bytes|$label")
    PACKED+=("$id")
    [[ "$kind" == dtu ]] && DTU_INCLUDED+=("$id")
    TOTAL_RAW=$(( TOTAL_RAW + raw ))
    TOTAL_PACKED=$(( TOTAL_PACKED + bytes ))

    local pct; pct=$(awk -v a="$bytes" -v b="$raw" 'BEGIN{printf "%d", (b?100*a/b:0)}')
    log_ok "$id -> $file ($(numfmt --to=iec "$bytes" 2>/dev/null || echo "$bytes"), ${pct}% of original)"
}

# ---------------------------------------------------------------------------
trim() { local s=$1; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

while IFS='|' read -r id kind dir sentinel source help label; do
    [[ -z "${id// }" || "${id:0:1}" == '#' ]] && continue
    id=${id// /}; kind=${kind// /}
    dir=$(trim "$dir"); sentinel=$(trim "$sentinel"); label=$(trim "$label")

    [[ "$kind" == docker ]] && continue
    [[ -n "$ONLY" && "$ONLY" != "$id" ]] && continue
    case "$FILTER" in
        dtu)  [[ "$kind" == dtu ]] || continue ;;
        free) [[ "$kind" == dtu ]] && continue ;;
    esac

    pack_one "$id" "$kind" "$dir" "$sentinel" "$label"
done <"$TOOLS_MANIFEST"

(( ${#PACKED[@]} > 0 )) || die "nothing was packed. Check $VEDA_TOOLS_DIR and your filters."

# --- write the manifest -----------------------------------------------------
# A partial run (--only / --dtu-only / --free-only) must not discard the
# entries for tools it did not touch, or the next install fails its checksum
# check on everything else. Carry those rows over.
if [[ -f "$MANIFEST" ]]; then
    declare -A REPACKED=()
    for row in "${ROWS[@]}"; do REPACKED[${row%%|*}]=1; done
    carried=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "${line// }" || "${line:0:1}" == '#' ]] && continue
        old_id=$(trim "${line%%|*}")
        [[ -n "${REPACKED[$old_id]:-}" ]] && continue
        # Keep it only if its archive is still in the output directory.
        old_file=$(trim "$(printf '%s' "$line" | cut -d'|' -f2)")
        if [[ -f "$OUT_DIR/$old_file" ]]; then
            ROWS+=("$line")
            carried=$(( carried + 1 ))
        else
            log_warn "dropping stale manifest entry '$old_id' ($old_file not in $OUT_DIR)"
        fi
    done <"$MANIFEST"
    (( carried > 0 )) && log_info "carried over $carried existing manifest entr(y/ies)"
fi

# Sort by id so the committed manifest has a stable diff.
mapfile -t ROWS < <(printf '%s\n' "${ROWS[@]}" | sort -t'|' -k1,1)

{
    printf '# VEDA mirror manifest -- generated by ./veda-pack on %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')"
    printf '# host: %s   format: %s\n' "$(hostname 2>/dev/null || echo unknown)" "$FORMAT"
    printf '#\n'
    printf '# id | filename | sha256 | bytes | label\n'
    printf '#\n'
    printf '# The installer verifies every mirror download against this file.\n'
    printf '# Commit it alongside the code: it is the integrity record, not a secret.\n'
    printf '# Regenerate after re-packing:  ./veda-pack\n'
    printf '\n'
    for row in "${ROWS[@]}"; do printf '%s\n' "$row"; done
} >"$MANIFEST"

log_ok "wrote $MANIFEST (${#ROWS[@]} entries)"

# --- summary ----------------------------------------------------------------
printf '\n'
banner "Bundle ready"
printf '   archives : %d\n' "${#PACKED[@]}"
printf '   raw      : %s\n' "$(numfmt --to=iec "$TOTAL_RAW" 2>/dev/null || echo "$TOTAL_RAW")"
printf '   packed   : %s' "$(numfmt --to=iec "$TOTAL_PACKED" 2>/dev/null || echo "$TOTAL_PACKED")"
awk -v a="$TOTAL_PACKED" -v b="$TOTAL_RAW" 'BEGIN{printf "  (%d%% of original)\n", (b?100*a/b:0)}'
printf '   location : %s\n' "$OUT_DIR"

if (( ${#SKIPPED[@]} > 0 )); then
    printf '\n   %sSkipped:%s\n' "$C_YELLOW$C_BOLD" "$C_RESET"
    for s in "${SKIPPED[@]}"; do printf '     ○ %s\n' "$s"; done
fi

if (( ${#DTU_INCLUDED[@]} > 0 )); then
    cat <<EOF

   ${C_YELLOW}${C_BOLD}This bundle contains licence-restricted tools:${C_RESET}
     ${DTU_INCLUDED[*]}

   These are licensed to you by DTU Health Tech for your own academic use and
   may NOT be redistributed. Host this bundle somewhere access-controlled:

     ${C_BOLD}a PRIVATE GitHub repository's release assets${C_RESET}  (recommended)
     storage only your group can read

   Not a public release, not a public web server, not Zenodo.
EOF
fi

# --- upload instructions ----------------------------------------------------
printf '\n   %sTo publish this bundle:%s\n\n' "$C_BOLD" "$C_RESET"
if [[ -n "$UPLOAD" && "$UPLOAD" == gh://* ]]; then
    spec=${UPLOAD#gh://}
    if [[ "$spec" == *@* ]]; then REPO=${spec%@*}; TAG=${spec##*@}; else REPO=$spec; TAG="tools-v1"; fi
else
    REPO="<your-org>/veda-tools"
    TAG="tools-v1"
fi

cat <<EOF
     # one-time: create a PRIVATE repo to hold the assets
     gh repo create $REPO --private

     # create the release and upload every archive
     gh release create $TAG --repo $REPO \\
         --title "VEDA tool bundle" --notes "Packed $(date '+%Y-%m-%d')" \\
         $OUT_DIR/*.$FORMAT

     # then point the installer at it
     echo 'MIRROR=gh://$REPO@$TAG' > installer/mirror.conf
     git add installer/mirror.conf installer/manifest/mirror.manifest
     git commit -m 'Point installer at the tool mirror'

   Anyone installing then runs just:  ./install.sh
   (they need 'gh auth login' once, for a private repo)
EOF

# --- optional: do the upload ------------------------------------------------
if [[ -n "$UPLOAD" ]]; then
    [[ "$UPLOAD" == gh://* ]] || die "--upload currently supports only gh://owner/repo@tag"
    have gh || die "the gh CLI is required for --upload (https://cli.github.com)"
    gh auth status >/dev/null 2>&1 || die "run 'gh auth login' first"

    printf '\n'
    if (( ${#DTU_INCLUDED[@]} > 0 )); then
        log_warn "about to upload licence-restricted tools to $REPO"
        log_warn "confirm that repository is PRIVATE before continuing"
    fi
    confirm "Upload ${#PACKED[@]} archive(s) to $REPO release '$TAG'?" n || {
        log_info "not uploaded; the commands above do it manually"
        exit 0
    }

    if gh release view "$TAG" --repo "$REPO" >/dev/null 2>&1; then
        log_info "release $TAG exists; uploading with --clobber"
        gh release upload "$TAG" --repo "$REPO" --clobber "$OUT_DIR"/*."$FORMAT" \
            || die "upload failed"
    else
        log_info "creating release $TAG"
        gh release create "$TAG" --repo "$REPO" \
            --title "VEDA tool bundle" --notes "Packed $(date '+%Y-%m-%d')" \
            "$OUT_DIR"/*."$FORMAT" || die "release creation failed"
    fi
    log_ok "uploaded to $REPO@$TAG"

    printf 'MIRROR=gh://%s@%s\n' "$REPO" "$TAG" >"$VEDA_INSTALLER_DIR/mirror.conf"
    log_ok "wrote installer/mirror.conf"
    printf '\n   Commit installer/mirror.conf and installer/manifest/mirror.manifest,\n'
    printf '   and every later install is just: ./install.sh\n\n'
fi
